{
  "name": "@step-security/github-pages-deploy-action",
  "description": "GitHub action for building a project and deploying it to GitHub pages.",
  "author": "step-security",
  "version": "4.9.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "test": "jest",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "lint:format": "prettier --write .",
    "lint:format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/github-pages-deploy-action.git"
  },
  "bugs": {
    "url": "https://github.com/step-security/github-pages-deploy-action/issues"
  },
  "homepage": "https://github.com/step-security/github-pages-deploy-action#readme",
  "keywords": [
    "actions",
    "node",
    "setup",
    "build",
    "deploy",
    "gh-pages",
    "pages",
    "github",
    "deploy",
    "deployment"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "@actions/io": "3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "typescript-eslint": "8.67.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.1",
    "jest": "30.5.0",
    "prettier": "3.9.6",
    "esbuild": "0.25.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  }
}
